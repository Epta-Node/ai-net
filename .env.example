# Backend: runtime mode, HTTP port, and log verbosity.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Backend: app version and graceful shutdown timeout in seconds.
NPM_PACKAGE_VERSION=0.1.0
GRACEFUL_SHUTDOWN_TIMEOUT=30

# Backend: database connection string used by persistence modules.
DATABASE_URL=./data/ai-net.db

# Backend: CORS origins and optional API/admin secrets.
ALLOWED_ORIGINS=http://localhost:3000
API_KEYS=
ADMIN_API_KEY=

# Backend and contracts: Stellar network and Horizon/RPC endpoints.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_HORIZON=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Backend and contracts: signing keys/public IDs. Keep real values out of git.
STELLAR_COORDINATOR_SECRET=
STELLAR_COORDINATOR_PUBLIC_KEY=
STELLAR_TEST_SECRET=
STELLAR_SECRET_KEY=
STELLAR_PUBLIC_KEY=
REGISTRY_CONTRACT_ID=
DEPLOYED_CONTRACT_IDS=

# Backend: local/test-only account verification bypass.
SKIP_STELLAR_ACCOUNT_VERIFY=false

# Backend and agent services: Venice API access and cache controls.
VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL_VERSION=v1
VENICE_CACHE_TTL_MS=86400000
VENICE_CACHE_CODING_TTL_MS=3600000
VENICE_CACHE_SIMILARITY_THRESHOLD=0.8

# Backend: response and route cache configuration.
CACHE_DRIVER=lru
REDIS_URL=redis://localhost:6379
CACHE_LRU_MAX_SIZE=500
CACHE_TTL_AGENTS=60
CACHE_TTL_STATS=30
CACHE_TTL_HEALTH=10

# Backend: input limits, rate limits, and per-wallet quotas.
MAX_PROMPT_LENGTH=10000
DAILY_TASK_LIMIT_PER_WALLET=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
REGISTER_RATE_LIMIT_MAX_REQUESTS=10

# Backend: agent heartbeat cleanup timings.
HEARTBEAT_INTERVAL_MS=300000
HEARTBEAT_STALE_THRESHOLD_MINUTES=5
AGENT_OFFLINE_DELETE_HOURS=24

# Backend: payment reconciliation scheduling and optional alerts.
RECONCILIATION_WEBHOOK_URL=
RECONCILIATION_INTERVAL_MS=86400000

# Backend: compression options.
COMPRESSION_THRESHOLD=1024
COMPRESSION_LEVEL=6
COMPRESSION_ENABLE_BROTLI=true

# Backend: API version negotiation.
API_LATEST_VERSION=2.0
API_SUPPORTED_VERSIONS=1.0,1.1,2.0
API_DEFAULT_VERSION=1.0
API_V1_SUNSET_DATE=

# Backend: WebSocket stream limits.
WS_MAX_CONNECTIONS_PER_CLIENT=5
WS_MAX_MESSAGES_PER_MINUTE=100
WS_INACTIVITY_TIMEOUT_MS=1800000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_PONG_TIMEOUT_MS=10000

# Backend: health dashboard metrics controls.
METRICS_CACHE_TTL_MS=5000
METRICS_WINDOW_MS=60000
METRICS_MAX_SAMPLES=1000

# Frontend: browser-visible API base URL consumed by Vite.
VITE_API_BASE_URL=http://localhost:3001

# Smart-contract tests/deploys: opt into live external tests.
RUN_STELLAR_E2E_TESTS=false
RUN_STELLAR_INTEGRATION_TESTS=false
RUN_VENICE_INTEGRATION_TESTS=false
RUN_SHARED_DEPLOY=false
