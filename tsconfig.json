{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["backend/src/*"],
      "@smart-contracts/*": ["smart-contracts/src/*"]
    }
  },
  "include": ["tests/**/*", "backend/src/**/*", "smart-contracts/src/**/*"]
}
