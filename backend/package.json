{
  "name": "ai-net-backend",
  "private": true,
  "version": "0.1.0",
  "description": "ai-net backend — Node.js/TypeScript server bridging frontend, agent runtime, Stellar payments, and Venice AI.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:e2e": "jest --config ../tests/e2e/jest.config.js --runInBand --forceExit",
    "db:migrate": "ts-node src/db/cli.ts migrate",
    "db:rollback": "ts-node src/db/cli.ts rollback",
    "db:seed": "ts-node src/db/cli.ts seed"
  },
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "12.3.0",
    "better-sqlite3": "^13.0.3",
    "compression": "1.7.5",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lru-cache": "^10.4.3",
    "nanoid": "^3.3.7",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.2",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "29.1.4",
    "ts-node": "10.9.2",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
