# ── Server Runtime ──────────────────────────────────────────────────────────────
# Server runtime environment: development | test | production.
NODE_ENV=development

# HTTP port for the backend API.
PORT=3001

# Pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Application version reported by health checks. Defaults to package version.
NPM_PACKAGE_VERSION=0.1.0

# Seconds to wait during graceful shutdown before forcing process exit.
GRACEFUL_SHUTDOWN_TIMEOUT=30

# Timeout in milliseconds for health probe HTTP checks.
HEALTH_PROBE_TIMEOUT_MS=5000

# Job queue depth (pending + failed) at which /health/deep reports the queue as
# degraded. Non-critical: the probe still answers 200.
HEALTH_QUEUE_DEPTH_WARN=1000

# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Trusted reverse proxies for client IP resolution. Default: none.
# Set a hop count (for example, 1) or trusted IP/CIDR ranges (for example, loopback,10.0.0.0/8).
TRUST_PROXY=none

# Optional comma-separated bearer API keys for protected API access.
API_KEYS=

# Optional shared secret for admin endpoints such as /health/dashboard.
ADMIN_API_KEY=

# Stellar network selector: testnet | mainnet | local | futurenet.
STELLAR_NETWORK=testnet

# Stellar Horizon endpoint used for account and payment checks.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional legacy alias for STELLAR_HORIZON_URL.
STELLAR_HORIZON=

# Optional public key used when local agents self-register.
STELLAR_PUBLIC_KEY=

# Set true only in local/test runs to bypass Horizon account validation.
SKIP_STELLAR_ACCOUNT_VERIFY=false

# Soroban RPC URL used by registry event sync.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional deployed AgentRegistry contract ID for event sync.
REGISTRY_CONTRACT_ID=

# Optional backend coordinator secret key for payment release signing.
STELLAR_COORDINATOR_SECRET=

# Optional testnet secret key used by live Stellar E2E tests.
STELLAR_TEST_SECRET=

# ── API & Authentication ───────────────────────────────────────────────────────
# Optional comma-separated bearer API keys for protected API access.
API_KEYS=

# Optional shared secret for admin endpoints such as /health/dashboard.
ADMIN_API_KEY=

# JWT secret key used to sign and verify access tokens.
AUTH_JWT_SECRET=ai-net-default-auth-secret-change-in-production

# Access token validity in seconds. Default: 900 (15 min).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token sliding expiry validity in seconds. Default: 604800 (7 days).
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Max absolute session lifetime in seconds. Default: 2592000 (30 days).
AUTH_SESSION_MAX_TTL_SECONDS=2592000

# ── API Versioning ────────────────────────────────────────────────────────────
# Latest API version advertised by versioning middleware.
API_LATEST_VERSION=2.0

# Comma-separated API versions accepted by the server.
API_SUPPORTED_VERSIONS=1.0,1.1,2.0

# API version used when the client omits API-Version.
API_DEFAULT_VERSION=1.0

# Optional HTTP Sunset header value for v1 clients.
API_V1_SUNSET_DATE=

# ── Venice AI & LLM Budget ────────────────────────────────────────────────────
# Venice AI API key. Required outside NODE_ENV=test.
VENICE_API_KEY=your_venice_api_key_here

# Venice API base URL.
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Logical model version used in Venice response cache keys.
VENICE_MODEL_VERSION=v1

# Default Venice response cache TTL in milliseconds.
VENICE_CACHE_TTL_MS=86400000

# Shorter Venice cache TTL for coding-agent responses in milliseconds.
VENICE_CACHE_CODING_TTL_MS=3600000

# Similarity threshold for semantic Venice cache reuse (0.0 to 1.0).
VENICE_CACHE_SIMILARITY_THRESHOLD=0.8

# Venice HTTP request timeout in milliseconds.
VENICE_REQUEST_TIMEOUT_MS=10000

# Maximum retries per provider before failing over.
VENICE_PROVIDER_MAX_RETRIES=3

# Optional comma-separated fallback API keys for Venice failover.
VENICE_FALLBACK_API_KEYS=

# Optional comma-separated fallback base URLs for Venice failover.
VENICE_FALLBACK_BASE_URLS=

# Total tokens (input + output) a single task may consume before it halts.
TASK_TOKEN_BUDGET=200000

# Daily LLM spend budget in USD across all tasks. A warning is logged at 75% and
# new work is refused at 100% (see GET /api/admin/cost-budget). 0 disables it.
DAILY_COST_BUDGET_USD=0

# Ceiling on one LLM call's max_tokens.
LLM_MAX_TOKENS_PER_CALL=8192

# Ceiling on one LLM call's input prompt; longer prompts are trimmed.
LLM_MAX_PROMPT_TOKENS=16000

# Format: model_name=inputUsd:outputUsd,... overrides for the pricing table.
VENICE_PRICING=

# How often in-flight task costs are flushed to the database in ms.
COST_FLUSH_INTERVAL_MS=60000

# ── Database & SQLite WAL Read Pool ───────────────────────────────────────────
# Filesystem path to the primary SQLite database file holding the ai-net schema.
# Note: SQLite with WAL mode is used for single-writer thread safety.
DATABASE_URL=./data/ai-net.db

# Optional: keep the versioned migration files outside src/db/migrations.
DB_MIGRATIONS_DIR=

# Apply pending schema migrations on server startup, before the server listens.
# Each migration is transactional, so startup aborts if one fails. Set to false
# to manage the schema with `npm run db:migrate` as a separate deploy step.
AUTO_MIGRATE=true

# SQLite connection pool size (minimum eager read-only connections).
DB_POOL_MIN=2

# SQLite connection pool size (maximum concurrent WAL read-only connections).
DB_POOL_MAX=10

# Timeout in ms to acquire a read-only SQLite connection handle.
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# Whether to run SELECT 1 on pooled SQLite reader handles before reuse.
DB_POOL_HEALTH_CHECK=true

# Database backup target directory.
DB_BACKUP_DIR=./data/backups

# Number of database backups to retain.
DB_BACKUP_RETENTION_COUNT=5

# Interval in ms for database maintenance tasks (e.g. WAL checkpoint, VACUUM).
DB_MAINTENANCE_INTERVAL_MS=3600000

# Auto-vacuum page count threshold before maintenance executes VACUUM.
DB_MAINTENANCE_VACUUM_THRESHOLD=100

# Path to the admin audit log SQLite database file.
ADMIN_AUDIT_DB_PATH=

# Target directory for admin-triggered system backups.
ADMIN_BACKUP_DIR=

# ── Caching ───────────────────────────────────────────────────────────────────
# Cache backend: lru | redis.
CACHE_DRIVER=lru

# Redis connection URL used when CACHE_DRIVER=redis.
REDIS_URL=redis://localhost:6379

# Maximum entries held by the in-process LRU cache.
CACHE_LRU_MAX_SIZE=500

# Agent list cache TTL in seconds.
CACHE_TTL_AGENTS=60

# Stats cache TTL in seconds.
CACHE_TTL_STATS=30

# Health cache TTL in seconds.
CACHE_TTL_HEALTH=10

# Deployment-scoped prefix for registry cache keys.
REGISTRY_CACHE_KEY_PREFIX=registry

# ── Rate Limiting & Quotas ────────────────────────────────────────────────────
# Maximum accepted task prompt length in characters.
MAX_PROMPT_LENGTH=10000

# Global fallback per-IP rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Global fallback maximum task-create requests per IP per window.
RATE_LIMIT_MAX_REQUESTS=20

# Rate limit for agent registration endpoint (/api/agents/register).
REGISTER_RATE_LIMIT_MAX_REQUESTS=10

# Rate limit for public unauthenticated endpoints (/health, /api/stats, GET /api/agents).
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=120

# Rate limit for authenticated endpoints (/api/tasks).
RATE_LIMIT_AUTHED_WINDOW_MS=60000
RATE_LIMIT_AUTHED_MAX_REQUESTS=30

# Rate limit for admin endpoints (/api/admin/*).
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX_REQUESTS=20

# Per-wallet rolling 24-hour daily task creation limit (0 to disable).
DAILY_TASK_LIMIT_PER_WALLET=100

# ── Heartbeat & Agent Watchdog ────────────────────────────────────────────────
# Agent heartbeat loop interval in milliseconds.
HEARTBEAT_INTERVAL_MS=300000

# Minutes before an unseen agent is considered stale.
HEARTBEAT_STALE_THRESHOLD_MINUTES=5

# Hours before stale offline agents are deleted.
AGENT_OFFLINE_DELETE_HOURS=24

# Agent watchdog check interval in milliseconds.
AGENT_WATCHDOG_INTERVAL_MS=60000

# Grace period in minutes before watchdog marks unresponsive agents offline.
AGENT_WATCHDOG_GRACE_MINUTES=10

# ── Agent Ownership Proof (#557, #558) ────────────────────────────────────────
# Lifetime of a single-use agent auth challenge, in milliseconds (default 5 min).
AGENT_CHALLENGE_TTL_MS=300000

# Failed unsigned agent-auth attempts tolerated per IP per window.
AGENT_AUTH_FAILURE_LIMIT_MAX=20

# Sliding window the failed unsigned agent-auth budget is measured over, in ms.
AGENT_AUTH_FAILURE_LIMIT_WINDOW_MS=60000

# ISO-8601 date the unsigned register/heartbeat path stops being tolerated.
# Leave empty to advertise no Sunset header yet.
AGENT_AUTH_SUNSET_DATE=

# ── Job Leases (#648) ─────────────────────────────────────────────────────────
# How long a worker's claim on a job stays valid without a heartbeat, in ms.
JOB_LEASE_TTL_MS=30000

# How often a running job's lease is renewed, in ms. Must be well inside the TTL.
JOB_LEASE_HEARTBEAT_MS=10000

# ── Job Retry Policy (#752) ───────────────────────────────────────────────────
# Failed jobs retry after random(0, min(JOB_BACKOFF_MAX_MS, JOB_BACKOFF_BASE_MS * 2^(attempt-1))) ms.
JOB_BACKOFF_BASE_MS=1000

# Ceiling for a single retry delay, in ms.
JOB_BACKOFF_MAX_MS=300000

# Attempts before a job is moved to the dead-letter queue with a terminal reason.
JOB_MAX_ATTEMPTS=3

# Error registry cleanup interval in milliseconds.
ERROR_REGISTRY_MAINTENANCE_INTERVAL_MS=3600000

# Maximum error records kept per agent in the error registry.
ERROR_REGISTRY_CAP_PER_AGENT=100

# ── Event Store Retention & Compaction ────────────────────────────────────────
# On-disk path for the append-only event store SQLite database.
EVENT_STORE_PATH=./data/events.db

# Retention window in days for finished task events.
EVENT_RETENTION_DAYS=30

# How often the compaction pass runs in milliseconds.
EVENT_COMPACTION_INTERVAL_MS=3600000

# Maximum tasks compacted per pass.
EVENT_COMPACTION_BATCH_TASKS=50

# Master switch for the event store retention compaction job.
EVENT_COMPACTION_ENABLED=true

# ── Idempotency Store ─────────────────────────────────────────────────────────
# Retention TTL in milliseconds for idempotency keys.
IDEMPOTENCY_TTL_MS=86400000

# Background cleanup interval in milliseconds for expired idempotency keys.
IDEMPOTENCY_CLEANUP_MS=300000

# ── WebSockets ────────────────────────────────────────────────────────────────
# Maximum concurrent WebSocket stream connections per client IP.
WS_MAX_CONNECTIONS_PER_CLIENT=5

# Maximum WebSocket messages per minute per connection.
WS_MAX_MESSAGES_PER_MINUTE=100

# WebSocket inactivity timeout in milliseconds.
WS_INACTIVITY_TIMEOUT_MS=1800000

# WebSocket heartbeat ping interval in milliseconds.
WS_HEARTBEAT_INTERVAL_MS=30000

# WebSocket pong timeout in milliseconds.
WS_PONG_TIMEOUT_MS=10000

# ── SSE task event stream (#751) ──────────────────────────────────────────────
# Maximum concurrent GET /api/tasks/:id/events/stream connections per client IP.
SSE_MAX_CONNECTIONS_PER_CLIENT=5

# Interval between SSE keep-alive comments, in milliseconds.
SSE_HEARTBEAT_INTERVAL_MS=15000

# ── Metrics ───────────────────────────────────────────────────────────────────
# Health dashboard cache TTL in milliseconds.
METRICS_CACHE_TTL_MS=5000

# Rolling metrics analytics window in milliseconds.
METRICS_WINDOW_MS=60000

# Maximum HTTP request samples retained in memory.
METRICS_MAX_SAMPLES=1000

# ── Quality Scorer ────────────────────────────────────────────────────────────
# Completeness dimension score weight (0.0 to 1.0).
QUALITY_WEIGHT_COMPLETENESS=0.4

# Relevance dimension score weight (0.0 to 1.0).
QUALITY_WEIGHT_RELEVANCE=0.3

# Format dimension score weight (0.0 to 1.0).
QUALITY_WEIGHT_FORMAT=0.3

# Score threshold below which output is flagged for review.
QUALITY_REVIEW_THRESHOLD=60

# Enable percentile rank normalization across historical agent output scores.
QUALITY_PERCENTILE_ENABLED=false

# Master switch for the retention job.
EVENT_COMPACTION_ENABLED=true

# --- Idempotency (Idempotency-Key on POST /api/tasks) ------------------------
# Keys are reserved before the handler runs, then stored so a retry replays the
# original response instead of creating a second task.

# How long a completed key is retained for replay, in milliseconds (24 h).
IDEMPOTENCY_TTL_MS=86400000

# How long an in-flight reservation is honoured before the key is treated as
# abandoned and becomes reusable, in milliseconds (5 min).
IDEMPOTENCY_PENDING_TTL_MS=300000

# How often expired keys are swept, in milliseconds (5 min).
IDEMPOTENCY_CLEANUP_MS=300000

# --- Reconciliation -----------------------------------------------------------
# Optional webhook notified when a payment reconciliation run completes.
RECONCILIATION_WEBHOOK_URL=

# How often the reconciliation job runs, in milliseconds (24 h).
RECONCILIATION_INTERVAL_MS=86400000

# --- Response compression -----------------------------------------------------
# Minimum response size in bytes before compression is attempted.
COMPRESSION_THRESHOLD=1024

# zlib compression level (1 = fastest, 9 = smallest).
COMPRESSION_LEVEL=6

# Send Brotli instead of gzip when the client supports it.
COMPRESSION_ENABLE_BROTLI=true

# --- Quality percentile scoring ----------------------------------------------
# Minimum samples required before percentile normalization is applied.
QUALITY_PERCENTILE_MIN_SAMPLES=10

# --- Admin control ------------------------------------------------------------
# Master switch: reject every mutating request with 503 while enabled.
AI_NET_READ_ONLY=false

# Operator-facing reason echoed in the 503 body while read-only mode is on.
AI_NET_READ_ONLY_REASON=

# --- Feature flags (#425) -----------------------------------------------------
# Compiled-in defaults live in src/services/featureFlags.ts. Leave these empty to
# use the default, or set true|false|1|0 to override it per deployment.
FEATURE_STREAMING_RESPONSES=
FEATURE_DAG_PREVIEW=
FEATURE_EXPERIMENTAL_AGENTS=
FEATURE_QUALITY_SCORER=
FEATURE_RECONCILIATION=
FEATURE_AGENT_OWNERSHIP_PROOF=
