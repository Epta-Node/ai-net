      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Reference Grafana dashboard for ai-net platform SLIs — HTTP traffic, task pipeline, agent health, payments, queue, and LLM latency.",
