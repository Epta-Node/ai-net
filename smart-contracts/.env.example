# Stellar network selector for scripts and integration tests.
STELLAR_NETWORK=testnet

# Horizon endpoint used by payment and market-report E2E tests.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint used by deploy/sync workflows.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Secret key for local/testnet contract-payment signing. Keep real values out of git.
STELLAR_SECRET_KEY=

# Coordinator secret key used by escrow/payment integration flows.
STELLAR_COORDINATOR_SECRET=

# Optional coordinator public key. If unset, some tests derive it from STELLAR_SECRET_KEY.
STELLAR_COORDINATOR_PUBLIC_KEY=

# Optional JSON map of predeployed contract IDs for shared integration fixtures.
DEPLOYED_CONTRACT_IDS=

# Venice AI API key used by live agent integration tests.
VENICE_API_KEY=your_venice_api_key_here

# Enable live Stellar E2E tests.
RUN_STELLAR_E2E_TESTS=false

# Enable live Stellar integration tests.
RUN_STELLAR_INTEGRATION_TESTS=false

# Enable live Venice integration tests.
RUN_VENICE_INTEGRATION_TESTS=false

# Reuse shared deployed contracts in integration fixtures.
RUN_SHARED_DEPLOY=false
